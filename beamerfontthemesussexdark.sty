\mode<presentation>

%   Libre Baskerville - titles and headings
%   Inter             - body copy (Semibold for running headers and footers)

\RequirePackage[T1]{fontenc}
\RequirePackage[scale=0.92]{librebaskerville}
\RequirePackage[sfdefault,scale=0.9]{inter}
\renewcommand{\ttdefault}{lmtt} % monospaced code: Latin Modern Typewriter

\newcommand{\sussexsemibold}{\fontseries{sb}\selectfont}

\setbeamerfont{title}{family=\librebaskerville,series=\bfseries,size=\Large}
\setbeamerfont{subtitle}{family=\librebaskerville,series=\mdseries,size=\large}
\setbeamerfont{frametitle}{family=\librebaskerville,series=\bfseries,size=\Large}
\setbeamerfont{framesubtitle}{family=\librebaskerville,series=\mdseries,size=\small}
\setbeamerfont{section title}{family=\librebaskerville,series=\bfseries,size=\huge}
\setbeamerfont{part title}{family=\librebaskerville,series=\bfseries,size=\huge}
\setbeamerfont{block title}{family=\sffamily\bfseries}
\setbeamerfont{author}{family=\sussexsemibold}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{footline}{family=\sussexsemibold,size=\scriptsize}
\setbeamerfont{author in head/foot}{family=\sussexsemibold,size=\scriptsize}
\setbeamerfont{section in head/foot}{family=\sussexsemibold,size=\scriptsize}
\setbeamerfont{page number in head/foot}{family=\sussexsemibold,size=\scriptsize}

\mode
<all>
